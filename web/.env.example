# Copy to .env.local. Both values end up in the public page, so never put a private API key here.

# The deployed MelbourneCupSweep address. Required.
VITE_SWEEP_ADDRESS=

# Optional. The test contract on Sepolia, which the page switches to with ?testnet=true on the URL.
VITE_TESTNET_SWEEP_ADDRESS=

# Optional. The chain it's deployed on: mainnet (the default), base, base-sepolia, sepolia or local.
VITE_CHAIN=

# Optional. Defaults to a few public RPCs for that chain.
VITE_RPC_URL=
